{
  "permissions": {
    "allow": [
      "Bash(python3 viewer/build.py)",
      "Bash(python3 site/build_site.py)",
      "Bash(python3 tools/harness_check.py)",
      "Bash(python3 tools/new_doc.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/harness_check.py 2>&1 | tail -20 || true"
          }
        ]
      }
    ]
  }
}
